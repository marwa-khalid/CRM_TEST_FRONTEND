# Local development — `npm run dev` (Vite mode: development).
# All API calls go to /api (SAME-ORIGIN with the SPA at http://localhost:5174).
# vite.config.ts proxies /api to the backend and sanitizes the auth cookie so it
# works over http://localhost. Same-origin => the cookie is first-party and sent.
VITE_BACKEND_BASE_URL=/api
VITE_BACKEND_BASE_URL2=/api
VITE_API_BASE_URL=/api

# Which backend the dev /api proxy forwards to. Defaults to the deployed Railway
# backend. Uncomment to point dev at a locally-run backend instead.
# VITE_DEV_API_TARGET=http://localhost:8080
